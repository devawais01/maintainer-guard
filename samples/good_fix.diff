@@ -18,9 +18,13 @@ def get_temperature(city):
     resp = requests.get(URL, params={"q": city, "appid": API_KEY}, timeout=10)
-    data = resp.json()
-    return data["main"]["temp"] - 273
+    resp.raise_for_status()
