diff --git a/tests/test_api.py b/tests/test_api.py
index 0000000..1111111 100644
--- a/tests/test_api.py
+++ b/tests/test_api.py
@@ -0,0 +1,9 @@
+from unittest.mock import patch
+from weather.api import get_temperature
+
+def test_kelvin_conversion():
+    fake = {"main": {"temp": 300.15}}
+    with patch("weather.api.requests.get") as g:
+        g.return_value.json.return_value = fake
+        g.return_value.raise_for_status.return_value = None
+        assert get_temperature("Lahore") == 27.0
